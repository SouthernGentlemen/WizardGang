{
  "name": "wizardgang-site",
  "version": "1.2.1",
  "private": true,
  "type": "module",
  "packageManager": "npm@12.1.0",
  "engines": {
    "node": "26.x",
    "npm": "12.x"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "fsevents@2.3.3": true,
    "workerd@1.20260925.1": true
  },
  "description": "Static company site for WizardGang at wizardgang.ai.",
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "check:frontend": "npm run typecheck && npm run build && node scripts/verify-react-shell.mjs",
    "check": "npm run test:plan-queue && npm run check:frontend && node scripts/verify.mjs && npm run test:github-settings && npm run test:release-tag && npm run test:deployment-boundary && npm run test:release-deployment && npm run check:history && npm run test:public-secrets && npm run check:public-secrets && npm run check:patch-integrity",
    "test:public-secrets": "node --test scripts/public-secret-cases.mjs",
    "check:public-secrets": "node scripts/check-public-secrets.mjs",
    "test:plan-queue": "node scripts/check-portfolio-contract.mjs",
    "test:github-settings": "node --test tests/github-settings.test.mjs",
    "verify:github-settings": "node scripts/verify-github-settings.mjs",
    "apply:github-settings": "node scripts/apply-github-settings.mjs",
    "test:release-identity": "node --test tests/release-identity.test.mjs",
    "verify:release-identity": "node scripts/release-identity.mjs",
    "check:history": "node scripts/check-controlled-history.mjs",
    "check:patch-integrity": "node scripts/check-patch-integrity.mjs",
    "test:history": "node --test tests/controlled-history.test.mjs",
    "audit:dependencies": "npm audit --audit-level=high",
    "security:dependency-advisories": "npm run audit:dependencies",
    "test:dev": "node --test tests/dev-lifecycle.test.mjs",
    "secrets:cloudflare:discover": "bash scripts/discover-cloudflare-api-token-targets.sh",
    "secrets:cloudflare:rotate": "bash scripts/rotate-cloudflare-api-token.sh",
    "dev": "node scripts/dev.mjs",
    "deploy:staging": "npm run build && wrangler deploy --env staging",
    "deploy:staging:dry-run": "npm run build && wrangler deploy --dry-run --env staging",
    "deploy:production:dry-run": "npm run build && wrangler deploy --dry-run --env production",
    "test:browser": "node --test tests/browser-behavior.test.mjs",
    "test:accessibility": "node --test tests/accessibility-contract.test.mjs",
    "test:docs": "node --test tests/documentation-current-state.test.mjs",
    "test:frontend-authority": "node --test tests/frontend-authority.test.mjs",
    "test:navigation": "node --test tests/navigation-authority.test.mjs",
    "test:release-tag": "node --test tests/release-tag.test.mjs",
    "test:deployment-boundary": "node --test tests/deployment-boundary.test.mjs",
    "test:release-deployment": "node --test tests/release-deployment-identity.test.mjs"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "26.6.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.1",
    "wrangler": "4.141.0"
  }
}
