{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "wizardgang-portfolio",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-08-28",
  // Let normal asset matching happen first. When no asset matches, invoke the stateless
  // Worker for its outward shortcuts instead of treating browser navigations as automatic 404 pages.
  "compatibility_flags": ["assets_navigation_has_no_effect"],
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "env": {
    "staging": {
      "name": "wizardgang-portfolio-staging",
      "workers_dev": true,
      "preview_urls": false
    },
    "production": {
      "name": "wizardgang-portfolio",
      "workers_dev": false,
      "preview_urls": false,
      "routes": [{ "pattern": "wizardgang.ai", "custom_domain": true }]
    }
  }
}
