{
  // The wizardgang Worker, conforming to baseline platform/wrangler.template.jsonc. Check it with:
  //   node platform/conformance/cli.mjs wrangler --worker wizardgang
  // Top level only. Production deploys run only through baseline's deploy-worker.yml.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "wizardgang",
  // Generated by npm run build, carrying the release the shell serves at /version.json.
  "main": "build/worker.mjs",
  "compatibility_date": "2026-08-31",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  // The shell 308s www.wizardgang.ai to the apex.
  "routes": [
    { "pattern": "wizardgang.ai", "custom_domain": true },
    { "pattern": "www.wizardgang.ai", "custom_domain": true }
  ],
  "observability": { "enabled": true },
  "vars": { "WG_APP": "wizardgang" },
  // The Worker runs first so the shell's host guard, www redirect and built-ins cover every path.
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  // The shared operator token and session key from default_secrets_store (runbook step 3.5).
  "secrets_store_secrets": [
    { "binding": "WG_OPS_TOKEN", "store_id": "e63e666172544d5c8c4a656ff28ac32a", "secret_name": "WG_OPS_TOKEN" },
    { "binding": "WG_SESSION_KEY", "store_id": "e63e666172544d5c8c4a656ff28ac32a", "secret_name": "WG_SESSION_KEY" }
  ]
}
