/*
  Content-Security-Policy: default-src 'none'; script-src 'self' https://static.cloudflareinsights.com; connect-src 'self' https://cloudflareinsights.com; style-src 'self'; font-src 'self'; img-src 'self' data:; manifest-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'; form-action 'none'; upgrade-insecure-requests
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  Cross-Origin-Opener-Policy: same-origin
  Cache-Control: public, max-age=0, must-revalidate, no-transform

/assets/*
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400

/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/og.jpg
  Cache-Control: public, max-age=604800, stale-while-revalidate=2592000

/og-jacob-yongue.jpg
  Cache-Control: public, max-age=604800, stale-while-revalidate=2592000

/hexframe-project.jpg
  Cache-Control: public, max-age=604800, stale-while-revalidate=2592000

/favicon.svg
  Cache-Control: public, max-age=604800
